# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Environments
.venv/
venv/
.env

# Data: downloaded or derived, rebuilt with `python -m src.data_fetcher`.
# Only the checksum manifest of the raw data is tracked.
data/*
!data/MANIFEST.sha256

# Outputs: regenerated by the experiments...
results/*
# ...except the frozen pre-registration record used by the blind test
!results/frozen/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
